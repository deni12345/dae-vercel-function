{
    "version": 2,
    "regions": ["sin1"],
    "functions": {
        "api/*.go": {
            "maxDuration": 60
        }
    },
    "routes": [
        {
            "src": "/api/sheet-listen",
            "dest": "/api/stream-sheet-updates.go",
            "methods": ["GET"]
        },
        {
            "src": "/api/collections",
            "dest": "/api/get-collecions.go",
            "methods": ["GET"]
        },
        {
            "src": "/api/(.*)",
            "dest": "/api/health.go",
            "methods": ["GET"]
        }
    ]
}